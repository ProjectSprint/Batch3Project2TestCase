            "number",
            "null"
          ] 
        },
        "height": {
          "type": [
            "number",
            "null"
          ] 
        },
        "imageUrl": {
          "type": [
            "string",
            "null"
          ] 
        },
        "name": {
          "type": [
            "string",
            "null"
          ] 
