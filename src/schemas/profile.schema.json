{
  "$ref": "#/definitions/Profile",
  "schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "PreferenceEnum": {
      "enum": [
        "CARDIO",
        "WEIGHT"
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "WeightEnum": {
      "enum": [
        "KG",
        "LBS"
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "HeightEnum": {
      "enum": [
        "CM",
        "INCH"
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "preference": {
          "type": [
            "string",
            "null"
          ]
        },
        "weightUnit": {
          "type": [
            "string",
            "null"
          ] 
        },
        "heightUnit": {
          "type": [
            "string",
            "null"
          ] 
        },
        "weight": {
          "type": [
            "number",
            "null"
          ] ,
          "minimum": 10,
          "maximum": 1000
        },
        "height": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 3,
          "maximum": 250
        },
        "imageUri": {
          "type": [
            "string",
            "null"
          ] 
        },
        "name": {
          "type": [
            "string",
            "null"
          ] 
        }
      },
      "required": [
        "preference",
        "weightUnit",
        "heightUnit",
        "weight",
        "height"
      ],
      "type": "object"
    }
  }
}
